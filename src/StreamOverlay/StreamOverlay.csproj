<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>tech.rethunk.mortar.StreamOverlay</AssemblyName>
    <AssemblyTitle>StreamOverlay</AssemblyTitle>
    <RootNamespace>StreamOverlay</RootNamespace>
    <RepositoryUrl>https://github.com/Rethunk-Tech/mortar-lc-streamoverlay</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <IsThunderstorePackable>true</IsThunderstorePackable>
    <ThunderstoreName>StreamOverlay</ThunderstoreName>
    <ThunderstoreDescription>Serves Mortar%27s stream overlay for Lethal Company: crew, quota and moon state for OBS.</ThunderstoreDescription>
    <ThunderstoreCommunities>lethal-company</ThunderstoreCommunities>
    <ThunderstoreCategories>mods;bepinex</ThunderstoreCategories>
  </PropertyGroup>

  <ItemGroup>
    <ModFile Include="$(TargetPath)" Destination="plugins/" />
  </ItemGroup>

  <ItemGroup>
    <ThunderstorePackageFile Include="$(SolutionRoot)README.md" />
    <ThunderstorePackageFile Include="$(SolutionRoot)CHANGELOG.md" />
    <ThunderstorePackageFile Include="$(SolutionRoot)icon.png" />
    <ThunderstorePackageFile Include="$(SolutionRoot)LICENSE" />
    <ThunderstoreDependency Include="BepInEx-BepInExPack" Version="5.4.2305" />
  </ItemGroup>
</Project>
